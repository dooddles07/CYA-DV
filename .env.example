# MongoDB connection string. On Railway this is provided by the MongoDB plugin:
# MONGO_URL=${{MongoDB.MONGO_URL}}
MONGO_URL=

# Secret for signing session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Public site URL used for canonical/OG metadata (optional).
NEXT_PUBLIC_SITE_URL=https://cya-daily-verses-production.up.railway.app

# --- Web push (optional; reminders are disabled if unset) ---
# Generate a key pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=

# Shared secret the scheduler sends to /api/cron/daily-verse.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# --- Admin portal ---
# Shared passphrase for /admin-portal. Anyone holding it gets full admin
# access, so treat it like a key to the building: long, random, rotated when
# a leader steps down. Sessions last 8 hours.
ADMIN_PORTAL_PASSWORD=

# --- Email for password resets (optional; reset is disabled if unset) ---
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 characters below.
# This is NOT your Google account password.
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

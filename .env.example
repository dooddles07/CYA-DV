# MongoDB connection string. Production uses a MongoDB Atlas cluster —
# copy the connection string from the Atlas dashboard (Database > Connect).
MONGO_URL=

# Secret for signing session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Public site URL. REQUIRED — boot fails if unset. Reset / verify-email links
# and canonical/OG metadata are built from it, so it must not silently fall back.
NEXT_PUBLIC_SITE_URL=https://cya-dv.vercel.app

# --- Web push (optional; reminders are disabled if unset) ---
# Generate a key pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=

# Shared secret the scheduler sends to /api/cron/daily-verse.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# --- Admin portal ---
# Shared passphrase for /admin-portal. Anyone holding it gets full admin
# access, so treat it like a key to the building: long, random, rotated when
# a leader steps down. Sessions last 8 hours.
ADMIN_PORTAL_PASSWORD=

# Optional: shared TOTP secret for the admin portal's second factor. Unset =
# portal MFA is skipped (passphrase-only). Admin-role member accounts always
# require MFA regardless of this — they enroll their own secret on first
# login. Generate with:
#   node --input-type=module -e "import{generateSecret}from './src/server/utils/totp.js';console.log(generateSecret())"
ADMIN_PORTAL_TOTP_SECRET=

# --- Email for password resets (optional; reset is disabled if unset) ---
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 characters below.
# This is NOT your Google account password.
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

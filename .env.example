# MongoDB connection string. Production uses a MongoDB Atlas cluster —
# copy the connection string from the Atlas dashboard (Database > Connect).
MONGO_URL=

# Secret for signing session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Public site URL. REQUIRED — boot fails if unset. Reset / verify-email links
# and canonical/OG metadata are built from it, so it must not silently fall back.
NEXT_PUBLIC_SITE_URL=https://cya-dv.vercel.app

# --- Web push (optional; reminders are disabled if unset) ---
# Generate a key pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=

# Shared secret the scheduler sends to /api/cron/daily-verse.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# --- Admin portal ---
# Shared passphrase for /admin-portal. Anyone holding it gets full admin
# access, so treat it like a key to the building: long, random, rotated when
# a leader steps down. Sessions last 8 hours.
ADMIN_PORTAL_PASSWORD=

# Optional: shared TOTP secret for the admin portal's second factor. Unset =
# portal MFA is skipped (passphrase-only). Admin-role member accounts always
# require MFA regardless of this — they enroll their own secret on first
# login. Generate with:
#   node --input-type=module -e "import{generateSecret}from './src/server/utils/totp.js';console.log(generateSecret())"
ADMIN_PORTAL_TOTP_SECRET=

# --- Email for password resets + verification (optional; disabled if unset) ---
# Resend's HTTP API, not SMTP — Vercel serverless functions can't reliably
# complete a raw SMTP handshake (outbound port 465/587 gets silently dropped).
# Get a key at https://resend.com/api-keys. Sandboxed to your Resend account's
# own signup email until you verify a sending domain in the Resend dashboard.
RESEND_API_KEY=
# Must be on a verified domain once you have one; the resend.dev address
# below only works in sandbox mode (sending to your own account email).
RESEND_FROM=CYA Daily Verse <onboarding@resend.dev>

# --- Reverse proxy (optional; defaults to 1) ---
# Number of trusted reverse-proxy hops in front of the app (the hosting
# platform's edge counts as one). Used to derive the real client IP from
# X-Forwarded-For for rate limiting — count from the right by this many hops
# so a client-injected leftmost address can't spoof identity. Only raise this
# if the deployment sits behind extra proxies (e.g. a CDN in front of Vercel).
TRUSTED_PROXY_HOPS=1
